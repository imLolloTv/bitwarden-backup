BW_CLIENTID=client_id
BW_CLIENTSECRET=client_secret

# Bitwarden Secrets Manager (attivo di default: true)
# Per disattivarlo e usare la classica BW_PASSWORD, imposta: USE_SECRET_MANAGER=false
USE_SECRET_MANAGER=true

# --- Se USE_SECRET_MANAGER=true (default) ---
# Access token del machine account (obbligatorio se USE_SECRET_MANAGER=true)
BWS_ACCESS_TOKEN=access_token_machine_account

# ID del secret contenente la master password (obbligatorio se USE_SECRET_MANAGER=true)
BW_SECRET_ID=uuid-del-secret

# Server Secrets Manager (opzionale, solo per istanze self-hosted)
# SM_BASE_URL=https://your-server.com

# --- Se USE_SECRET_MANAGER=false ---
# BW_PASSWORD=password_master

# Server Bitwarden (default: https://vault.bitwarden.com)
BW_SERVER=https://vault.bitwarden.com

# Crittografia AES-256 del backup (opzionale)
# ENCRYPTION_KEY=chiave_segreta_molto_lunga

# Webhook per notifiche di successo/errore (opzionale)
# WEBHOOK_URL=https://n8n.tuodominio.com/webhook/bitwarden-backup
